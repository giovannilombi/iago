    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IAGO reads your Calendar only to title the calls you record and remind you to record them. Nothing leaves your Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "IAGO legge il Calendario solo per dare il titolo alle call che registri e ricordarti di registrarle. Nulla lascia il tuo Mac."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IAGO records your voice during calls to transcribe it locally."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "IAGO registra la tua voce durante le call per trascriverla in locale."
          }
