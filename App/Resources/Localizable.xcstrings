      }
    },
    "Perderai tutto il materiale del progetto: %lld elementi con audio e documenti, %lld trascrizioni e %lld note. Non si potrà recuperare, nemmeno dal cestino." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
