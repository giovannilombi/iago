      }
    },
    "«%@»: %lld elementi con audio nella vista attuale. Ogni audio diventa un normale file .m4a nella cartella che scegli." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”: %2$lld items with audio in the current view. Each audio becomes a regular .m4a file in the folder you choose."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "«%1$@»: %2$lld elementi con audio nella vista attuale. Ogni audio diventa un normale file .m4a nella cartella che scegli."
          }
        }
      }
    },
    "«%@»: %lld elementi della vista attuale (filtri: %@), in ordine cronologico, in un unico file Markdown da dare a Claude o a un altro LLM." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”: %2$lld items from the current view (filters: %3$@), in chronological order, in a single Markdown file to give to Claude or another LLM."
