            "state" : "translated",
            "value" : "Upcoming milestones"
          }
        }
      }
    },
    "Prova a togliere qualche filtro o a spostare la data più avanti." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try removing some filters or moving the date later."
