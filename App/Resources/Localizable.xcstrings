    "«%@»" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”"
          }
        }
      }
    },
    "«%@» dipende già da questa voce, direttamente o tramite altre: non può anche bloccarla. Togli «%@» da «Dipende da»." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” already depends on this entry, directly or through others: it can't also block it. Remove “%2$@” from “Depends on”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "«%1$@» dipende già da questa voce, direttamente o tramite altre: non può anche bloccarla. Togli «%2$@» da «Dipende da»."
          }
        }
      }
    },
    "«%@» è in IAGO." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is in IAGO."
          }
        }
