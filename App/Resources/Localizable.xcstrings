    },
    "Scrive la sintesi della call con il modello della sua categoria (1to1, SAL, Kickoff…). Ogni punto porta il minuto da cui viene, controllato sulla trascrizione; le sezioni senza contenuto dicono «Non emerso»." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes the call summary with its category's template (1to1, Progress review, Kickoff…). Each point carries the minute it comes from, checked against the transcript; sections with no content say “Not mentioned”."
          }
        }
      }
    },
    "Scrivere il progetto in chiaro nel vault?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
