    },
    "Il Mac potrebbe non bastare" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac may not be enough"
          }
        }
      }
    },
    "Il miglior riordino del testo" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The best text tidy-up"
          }
        }
      }
    },
    "Il modello %@ è danneggiato: scaricalo di nuovo da Impostazioni." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %@ model is damaged: download it again from Settings."
          }
