    },
    "Per %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For %@"
          }
        }
      }
    },
    "Per avvisarti quando una trascrizione è pronta o una registrazione interrotta è stata recuperata. Facoltative." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To let you know when a transcript is ready or an interrupted recording has been recovered. Optional."
          }
        }
      }
    },
    "Per chi segue il progetto ogni giorno" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For people who follow the project every day"
          }
        }
