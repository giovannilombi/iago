    "Il consigliato con 16 GB: il più piccolo che fa anche le sintesi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recommended with 16 GB: the smallest that also writes summaries."
          }
        }
      }
    },
    "Il doppio della memoria (circa 6 GB) e del tempo del 4B" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twice the memory (about 6 GB) and time of the 4B"
          }
        }
      }
    },
    "Il file esportato non è cifrato: trattalo con la stessa cura dei documenti originali." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The exported file isn't encrypted: handle it with the same care as the original documents."
