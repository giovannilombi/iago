    },
    "«%@» nell'oggetto" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” in the subject"
          }
        }
      }
    },
    "«%@» oggi viene dopo questa voce nella catena. Se confermi, questa voce passa dopo «%@» e il resto della catena resta in ordine." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” currently comes after this entry in the chain. If you confirm, this entry moves after “%2$@” and the rest of the chain stays in order."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "«%1$@» oggi viene dopo questa voce nella catena. Se confermi, questa voce passa dopo «%2$@» e il resto della catena resta in ordine."
          }
        }
      }
    },
    "«%@» somiglia a:" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” looks like:"
          }
