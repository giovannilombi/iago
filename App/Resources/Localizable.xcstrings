    "Proposte da controllare: niente cambia finché non le confermi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggestions to review: nothing changes until you confirm them."
          }
        }
      }
    },
    "Proposte dal motore locale a partire dalle call, dalle email e dai documenti. Diventano punti chiave solo se le confermi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggestions from the local engine based on calls, emails and documents. They become key points only if you confirm them."
          }
