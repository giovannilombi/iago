            "value" : "Stays 1 hour in “Temporarily dismissed”"
          }
        }
      }
    },
    "Resta solo in IAGO: Claude non lo vede, nemmeno se è collegato a IAGO." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stays only in IAGO: Claude doesn't see it, even if connected to IAGO."
          }
        }
      }
    },
    "Restano spente finché non ti servono. Accese, compaiono nella scelta della categoria come sottomenu della loro famiglia." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
