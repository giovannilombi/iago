    "La completa" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complete"
          }
        }
      }
    },
    "La configurazione di Claude Desktop non è leggibile: copia la configurazione a mano." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Desktop's configuration can't be read: copy the configuration manually."
          }
