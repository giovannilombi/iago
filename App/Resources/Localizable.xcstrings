    "Le tue call, trascritte e organizzate. Solo sul tuo Mac." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your calls, transcribed and organized. Only on your Mac."
          }
        }
