MACOSX_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
ARCHS = arm64
PRODUCT_BUNDLE_IDENTIFIER = com.giovannilombi.iago
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
ENABLE_HARDENED_RUNTIME = YES
// YES only in the builds of scripts/release.sh (the DMG): they look for updates; a build from source does not.
IAGO_DISTRIBUTION = NO

#include? "Local.xcconfig"
