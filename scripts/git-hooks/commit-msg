#!/usr/bin/env bash
# Installed by scripts/bootstrap.sh (core.hooksPath), ADR-0065:
# - no AI attribution: a Claude co-author or a "Generated with Claude" line blocks the commit;
# - every other author in Config/team.txt is added as "Co-Authored-By", so the rights belong to all of them.
set -euo pipefail
MSG="$1"
if grep -i -q -E '^co-authored-by:.*(claude|anthropic)|generated with .*claude' "$MSG"; then
  echo "✘ Commit blocked: no Claude co-author or \"Generated with Claude\" line (ADR-0065)." >&2
  exit 1
fi
# - no email address in the message other than the anonymous GitHub ones (ADR-0065).
if grep -v '^#' "$MSG" | grep -o -E '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' \
  | grep -q -v -E '^([0-9]+\+)?[A-Za-z0-9-]+@users\.noreply\.github\.com$'; then
  echo "✘ Commit blocked: the message contains an email address; only the anonymous GitHub ones (ADR-0065)." >&2
  exit 1
fi
# - documentation in the same commit (ADR-0068): a change to the app's or the packages' code also touches the guide
#   (App/Resources/Guide) or the documentation (docs/), or says why not with a "Docs: <reason>" line.
STAGED=$(git diff --cached --name-only)
if printf '%s\n' "$STAGED" | grep -q -E '^(App/Sources/|Packages/[^/]+/Sources/|project\.yml$)' \
  && ! printf '%s\n' "$STAGED" | grep -q -E '^(App/Resources/Guide/|docs/)' \
  && ! tail -n +2 "$MSG" | grep -q -E '^Docs:[[:space:]]*[^[:space:]]'; then
  echo "✘ Commit blocked: the code changes but the documentation does not (ADR-0068)." >&2
  echo "  Update the in-app guide (App/Resources/Guide, how to use it) and/or the technical pages (docs/tecnica)," >&2
  echo "  or add a line \"Docs: <reason>\" to the message (e.g. \"Docs: internal refactoring, no visible change\")." >&2
  exit 1
fi
TEAM="$(git rev-parse --show-toplevel)/Config/team.txt"
[[ -f "$TEAM" ]] || exit 0
AUTHOR_EMAIL=$(git var GIT_AUTHOR_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')
while IFS= read -r person; do
  [[ -z "$person" || "$person" == \#* ]] && continue
  email=$(printf '%s' "$person" | sed -n 's/.*<\(.*\)>.*/\1/p')
  [[ "$email" == "$AUTHOR_EMAIL" ]] && continue
  grep -q -i -F "Co-Authored-By: $person" "$MSG" && continue
  git interpret-trailers --in-place --if-exists addIfDifferent --trailer "Co-Authored-By: $person" "$MSG"
done < "$TEAM"
